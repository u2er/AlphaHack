{
  "version": 1,
  "disable_existing_loggers": false,
  "formatters": {
    "colored": {
      "()": "utils.logging_utils.ColorFormatter",
      "format": "%(asctime)s | %(levelname)-8s | %(source_file)s | %(message)s",
      "datefmt": "%H:%M:%S"
    },
    "detailed": {
      "()": "utils.logging_utils.SourceFormatter",
      "format": "[%(asctime)s] {%(source_file)s:%(lineno)d} %(levelname)s - %(message)s",
      "datefmt": "%H:%M:%S"
    }
  },
  "handlers": {
    "console": {
      "class": "logging.StreamHandler",
      "level": "INFO",
      "formatter": "colored",
      "stream": "ext://sys.stderr"
    },
    "file": {
      "class": "logging.handlers.RotatingFileHandler",
      "level": "INFO",
      "formatter": "detailed",
      "filename": "logs.txt",
      "maxBytes": 10485760,
      "backupCount": 5,
      "encoding": "utf-8"
    }
  },
  "root": {
    "level": "INFO",
    "handlers": [
      "console",
      "file"
    ]
  },
  "loggers": {
    "httpcore": {"level": "WARNING"},
    "httpx": {"level": "WARNING"},
    "hpack": {"level": "WARNING"}
  }
}
