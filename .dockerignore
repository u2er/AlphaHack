# Секреты в образ не попадают никогда: конфиг приезжает из окружения, которое
# compose наполняет файлом .env в корне репозитория.
.env
*.env
!.env.example

__pycache__/
*.py[cod]
.pytest_cache/
.venv/
venv/
data/

# Локальные проходы мастера профиля: значения полей и ответы пользователя.
gui/runs/
profile/drafts/
profile/output/
profile/logs/

# PDF, которые оператор кладёт для PDF-источника (том ./pdfs).
pdfs/

# Файловый лог utils/logging_config.json.
logs.txt
