# Настройки EventGraph. compose читает этот файл (скопируйте в .env).

# Ключ API — заголовок X-Api-Key. Пустой ключ = API закрыт (кроме /health).
API_KEY=

# Порт API на хосте и пароль базы. DB_PORT — порт базы на 127.0.0.1 хоста
# (для CLI профиля и тестов вне контейнеров).
PORT=8000
DB_PASSWORD=eventgraph
DB_PORT=5433

# --- LLM агентов: OpenAI-совместимый API с вызовом инструментов ---
# Без ключа агенты не работают, а записи просто копятся.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek/deepseek-v4.1-flash
# Видит ли модель картинки. false — записи уходят агенту только текстом.
LLM_VISION=false
# Дополнительные параметры запроса, JSON. Пример для моделей, которым без
# этого инструменты отвечают 400: {"reasoning_effort": "none"}
# Те же LLM_* читает и профиль компании (utils/config.py). Шестерёнка в
# интерфейсе меняет их поверх .env без перезапуска (DATA_DIR/llm-settings.json).
LLM_PARAMS=
# Потолок ответа профиля вместе с рассуждениями (Responses API). У DeepSeek
# модель — id из /models (deepseek-flash, deepseek-v4-pro), не отображаемое имя.
LLM_MAX_TOKENS=16000
# Каких агентов запускать: news, gardener, analyst.
AGENTS=news,gardener,analyst

# --- Аналитик и профили клиентов ---
# Перед разбором каждой записи аналитик оценивает, насколько она важна для
# каждого клиента и как может повлиять на его бизнес. Клиенты — экспорты
# мастера профиля: PUT /profiles или файлы в PROFILES_DIR (в compose — /profiles,
# туда пишет GUI профиля). Пустой каталог — только PUT /profiles.
PROFILES_DIR=
# Профили-примеры (eventgraph/seed/profiles/: 8 компаний набора и 2 демо) —
# загружаются при старте воркера, если их ещё нет. Путь — свой каталог, off — нет.
PROFILE_EXAMPLES=builtin
# Профиль-текст на случай, когда ни одного профиля не загружено. Пусто — в
# промпте заготовка-плейсхолдер. Несколько строк — в двойных кавычках.
COMPANY_PROFILE=
# Порог важности 0–5 (меняется и через PUT /graph/settings — min_importance):
# запись ниже порога для всех клиентов не идёт в разбор и в граф. 0 — без порога.
ANALYST_MIN_IMPORTANCE=0
# Сколько клиентов аналитик оценивает одновременно для одной записи (раны LLM
# параллельно). Больше — быстрее очередь, но ближе к лимитам API.
ANALYST_CONCURRENCY=4

# --- Профиль компании (profile/, gui/) ---
# База — та же, что у EventGraph (схема profile_data). Для запуска CLI/GUI с
# хоста: postgresql://eventgraph:eventgraph@127.0.0.1:5433/eventgraph
PROFILE_DATABASE_URL=
PROFILE_GUI_PORT=8765
# Ключ входа в интерфейс (порт открыт наружу). Пусто — при первом старте GUI
# создаёт случайный ключ из 40 символов, пишет его в DATA_DIR/gui-access-key и
# в лог: docker compose logs profile-gui | grep 'ключ доступа'.
# Свой ключ: python -c "import secrets,string;a=string.ascii_letters+string.digits;print(''.join(secrets.choice(a) for _ in range(40)))"
GUI_ACCESS_KEY=
# Интерфейс «Альфа-Бизнес» (gui/) берёт ленту из API EventGraph; в compose —
# http://api:8000, ключ — API_KEY выше.
EVENTGRAPH_URL=http://127.0.0.1:8000
# PDF аналитики банка — сканы: auto (docling, если установлен; иначе текстовый
# слой + OCR tesseract), docling, text, ocr.
PDF_PARSER=auto
OCR_LANGUAGES=rus+eng

# --- Эмбеддинги графа, сюжетов и библиотеки профиля ---
# Пустой адрес — локальная модель fastembed в процессе (качается при первом
# запуске в /data/models). Иначе — OpenAI-совместимый /v1/embeddings.
# Одна модель на всё. Для аналитики банка лучше intfloat/multilingual-e5-large
# (1024, читает 512 токенов; ~2 ГБ). Смена модели — новая база графа и
# python -m profile.db.prepare --replace: векторы разных моделей несравнимы.
EMB_BASE_URL=
EMB_API_KEY=
EMB_MODEL=sentence-transformers/paraphrase-multilingual-mpnet-base-v2
# Готовые векторы базового графа и профилей-примеров: builtin, путь к .npz или off.
EMB_CACHE=builtin

# --- Граф ---
GRAPH_NAME=news
# Базовый граф при пустом графе: builtin (снимок новостей на 21.10.2026), путь к
# своему снимку (выгрузка GET /graphs/{graph}) или off.
GRAPH_SEED=builtin
GRAPH_SEARCH_LIMIT=8
GRAPH_SCORE_THRESHOLD=0.35

# --- Разбор новостей ---
# Каждая собранная запись сразу уходит агенту отдельным раном. Текст записи
# режется до NEWS_ITEM_CHARS; картинок — не больше NEWS_ITEM_IMAGES (через
# PUT /graph/settings — item_images), длинная сторона — NEWS_IMAGE_EDGE px.
# После NEWS_MAX_ATTEMPTS ранов без вердикта запись получает failed.
NEWS_ITEM_CHARS=4000
NEWS_ITEM_IMAGES=2
NEWS_IMAGE_EDGE=512
NEWS_MAX_ATTEMPTS=3

# --- Сюжеты ---
# Записи об одном событии — один сюжет: агент видит, в какие события графа уже
# разобраны другие его записи. Почти дословный повтор уже разобранного
# закрывается без агента; DUPLICATE_THRESHOLD=0 — не закрывать.
STORIES_ENABLED=true
STORY_THRESHOLD=0.85
STORY_WINDOW_HOURS=24
DUPLICATE_THRESHOLD=0.97
DUPLICATE_WINDOW_HOURS=48

# --- Потолки ---
CONNECTOR_TIMEOUT=300
TOOL_TIMEOUT=600
RUN_TIMEOUT=1800
LLM_TIMEOUT=300

LOG_LEVEL=INFO

# --- Интернет-поиск агентов (web_search, сервис searxng) ---
# Пусто — поиск выключен; по умолчанию compose ставит http://searxng:8080.
# SEARXNG_URL=
# Случайная строка: openssl rand -hex 32
SEARXNG_SECRET=
WEB_SEARCH_RESULTS=5
WEB_SEARCH_FRAGMENTS=2
